
@{
    ViewData["Title"] = "Rezervasyon";
    Layout = "~/Areas/Admin/Views/Layout/_Layout.cshtml";
}

<h2>Rezervasyon Yapın</h2>

<form method="post" asp-action="FormBooking" asp-area="User">
    <div class="row g-3">
        <div class="col-12">
            <label for="CarId">Araç Seçin</label>
            <select class="form-select" name="CarId" asp-items="@(ViewBag.CarList)">
                <option selected>Araç seçin</option>
            </select>
            <span asp-validation-for="CarId" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label for="PickupLocation">Pick-Up Konumu</label>
            <input class="form-control" type="text" name="PickupLocation" placeholder="Pick-Up Konumu" required>
            <span asp-validation-for="PickupLocation" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label for="DropoffLocation">Drop-Off Konumu</label>
            <input class="form-control" type="text" name="DropoffLocation" placeholder="Drop-Off Konumu" required>
            <span asp-validation-for="DropoffLocation" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button class="btn btn-light w-100 py-2" type="submit">Rezervasyon Yap</button>
        </div>
    </div>
</form>

