@using Cental.DtoLayer.AboutDtos
@model CreateAboutDto
@{
    ViewData["Title"] = "Hakkımızda | Oluşturma Sayfası";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@* 
<h3>yeni hakkımızda oluşturma Alanı</h3> *@

<form method="post">
    <label>Vizyonumuz</label>
    <input type="text" asp-for="Vision" class="form-control accordion-item" />
    <br />

    <label>Misyonumuz</label>
    <input type="text" asp-for="Mission" class="form-control" />
    <br />

    <label>Açıklama</label>
    <input type="text" asp-for="Description1" class="form-control" />
    <br />

    <label>Açıklama 2</label>
    <input type="text" asp-for="Description2" class="form-control" />
    <br />

    <label>Başlama yılı</label>
    <input type="number" asp-for="StartYear" class="form-control" />
    <br />

    <label>Fotoğraf 1</label>
    <input type="text" asp-for="ImageUrl1" class="form-control" />
    <br />

    <label>foto 2</label>
    <input type="text" asp-for="ImageUrl2" class="form-control" />
    <br />

    <label>İtem 1</label>
    <input type="text" asp-for="İtem1" class="form-control" />
    <br />

    <label>item 2 </label>
    <input type="text" asp-for="İtem2" class="form-control" />
    <br />

    <label>item 3</label>
    <input type="text" asp-for="İtem3" class="form-control" />
    <br />

    <label>item 4</label>
    <input type="text" asp-for="İtem4"class="form-control" />
    <br />

    <label>Ad Soyad</label>
    <input type="text" asp-for="NameSurname" class="form-control" />
    <br />

    <label>Meslek</label>
    <input type="text" asp-for="JobTitle " class="form-control" />
    <br />

    <label>profil Fotoğrafı</label>
    <input type="text" asp-for="ProfilePicture " class="form-control" />
    <br />

    <button class="btn btn-success">Kaydet</button>


</form>
