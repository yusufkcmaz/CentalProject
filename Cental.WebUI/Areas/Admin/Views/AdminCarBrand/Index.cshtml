@using Cental.EntityLayer.Entities
@using PagedList.Core
@model PagedList<CarBrand>
@{
    ViewData["Title"] = "Markalar";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Marka Sayfalar</h3>
@{ 
    int count = Model.PageSize * Model.PageNumber - (Model.PageSize );
}

<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>Marka</th>
        <th>Sil</th>
        <th>Güncelle</th>

    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count.</td>
            <td>@item.BrandName</td>
            <td><a asp-action="DeleteCarBrand" asp-route-id="@item.CarBrandId" class="btn btn-danger"><i class="fa fa-trash"></i>siL</a> </td>
            <td><a asp-action="UpdateCarBrand" asp-route-id="@item.CarBrandId" class="btn btn-info"><i class=" fa fa-pen"></i>Güncelle</a> </td>

        </tr>
    }

</table>

<div class="text-center">
    <pager asp-action="Index" asp-controller="AdminCarBrand" list="@Model" ></pager>
</div>

<a asp-action="CreateCarBrand" asp-controller="AdminCarBrand" class="btn btn-primary">Yeni Marka Ekle</a>


