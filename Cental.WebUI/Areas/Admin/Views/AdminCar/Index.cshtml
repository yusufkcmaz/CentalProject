@using Cental.EntityLayer.Entities
@model List<Car>
@{
    ViewData["Title"] = "ARABALAR";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@{
    int count = 0;
}
<br />
<br />
<br />

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">

        <tr>
            <th>#</th>
            <th>Araç Marka</th>
            <th>Araç Model</th>
            <th>Model Yılı</th>
            <th>Kilometre</th>
            <th>Sil</th>
            <th>Güncelle</th>

        </tr>

    </thead>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.Brand.BrandName</td>
            <td>@item.ModelName</td>
            <td>@item.Year</td>
            <td>@item.KM</td>


            <td>
                <a asp-action="DeleteCar" asp-route-id="@item.CarId"
                   class="btn btn-danger"><i class="fa fa-trash"></i>siL</a>
            </td>

            <td>
                <a asp-action="UpdateCar" asp-route-id="@item.CarId"
                   class="btn btn-info"><i class=" fa fa-pen"></i>Güncelle</a>
            </td>

        </tr>
    }

</table>
<a asp-action="CreateCar" asp-controller="AdminCar" class="btn btn-primary">Yeni Araba Ekle</a>



