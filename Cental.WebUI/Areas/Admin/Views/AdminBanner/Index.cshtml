@using Cental.DtoLayer.BannerDtos
@model List<ResultBannerDto>
@{
    ViewData["Title"] = "Öne Çıkan Alan";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Öne çıkan alan</h3>
@{
    int count = 0;
}

<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>Resim</th>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>Sil</th>
        <th>Güncelle</th>
        <th>Ekle</th>



    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count.</td>
            <td><img src="@item.ImageUrl" style="width:75px; height:100px;"></img></td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td><a asp-action="DeleteBanner" asp-route-id="@item.BannerId" class="btn btn-danger">siL</a> </td>
            <td><a asp-action="UpdateBanner" asp-route-id="@item.BannerId" class="btn btn-info">Güncelle</a> </td>

            <td><a asp-action="CreateBanner" asp-controller="AdminBanner" class="btn btn-primary">Yeni Öne Çıkan Alan Ekle</a></td>


        </tr>
    }

</table>
