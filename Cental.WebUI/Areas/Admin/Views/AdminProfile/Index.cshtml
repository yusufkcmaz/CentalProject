@using Cental.DtoLayer.UserDtos
@model ProfileEditDto
@{
    ViewData["Title"] = "Profil Güncelleme";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm mx-auto" style="max-width: 500px;">
    <div class="card-header bg-dark text-white text-center">
        <h4>Profil Güncelleme</h4>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div class="text-center mb-4">
                <img src="@Model.ImageUrl" class="rounded" style="width:80px; height:100px; object-fit:cover;" alt="Profil Resmi" />
                <input type="file" asp-for="ImageFile" accept="image/png,image/jpg,image/jpeg" class="form-control mt-2" />
                <input type="hidden" asp-for="ImageUrl" />
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">Ad</label>
                <input asp-for="FirstName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Soyad</label>
                <input asp-for="LastName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Telefon Numarası</label>
                <input asp-for="PhoneNumber" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Bilgileri Güncellemek için Şifrenizi Girin</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" required />
            </div>

            <div class="text-danger mb-3">
                @Html.ValidationSummary()
            </div>

            <button type="submit" class="btn btn-outline-danger w-100">Güncelle</button>
        </form>
    </div>
</div>
