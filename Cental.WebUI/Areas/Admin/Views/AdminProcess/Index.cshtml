@using Cental.EntityLayer.Entities
@model List<Process>
 
@{
    ViewData["Title"] = "Process List";
    Layout = "~/Areas/Admin/Views/Layout/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">📋 İşlemler Listesi</h4>
        </div>

        <div class="card-body">
            <table class="table table-hover table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.ProcessId</td>
                            <td class="align-middle">@item.Title</td>
                            <td class="align-middle">@item.Description</td>
                            <td class="align-middle">

                                <a asp-area="Admin" asp-controller="AdminProcess" asp-action="UpdateProcess" asp-route-id="@item.ProcessId"
                                   class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>


                                <button onclick="DeleteProcess(@item.ProcessId)" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i>Sil</button>



                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <div class="card-footer text-center">
            <a asp-area="Admin" asp-controller="AdminProcess" asp-action="AddProcess"
               class="btn btn-success fw-bold">
                <i class="fas fa-plus-circle"></i> Yeni Ekle
            </a>
        </div>
    </div>
</div>

<script>

     function DeleteProcess( id){


            Swal.fire({
                title: "Silmek istediğinize emin misiniz?",
                text: "Bu İşlemi geri alamazsınız!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Evet, Sil!",
                cancelButtonText:"İptal Et"
            }).then((result) => {
                if (result.isConfirmed) {
    window.location.href = "/Admin/AdminProcess/DeleteProcess/" + id;


                }
            });


        }

          




</script>
