@using Cental.DtoLayer.RoleDtos
@model UpdateaRoleDto
@{
    ViewData["Title"] = "Role Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm mx-auto" style="max-width: 450px;">
    <div class="card-header bg-dark text-white border-bottom border-secondary">
        <h4 class="mb-0">Rol Güncelle</h4>
    </div>
    <div class="card-body">

        <form method="post" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Rol Adı</label>
                <input asp-for="Name" class="form-control" />
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Name)</span>
            </div>

            <button type="submit" class="btn btn-outline-dark w-100">
                <i class="fa fa-pen"></i> Güncelle
            </button>
        </form>

    </div>
</div>
