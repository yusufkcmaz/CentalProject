@using Cental.EntityLayer.Entities
@model Service
@{
    ViewData["Title"] = "Service Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<br />
<br />
<br /> 

<div class="container">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4>Yeni Servis Ekle</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Başlık</label>
                    <input type="text" asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <input type="text" asp-for="Description" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Icon" class="form-label">Görsel İkon</label>
                    <input type="text" asp-for="Icon" class="form-control" />
                </div>

                <button type="submit" class="btn btn-success">Kaydet</button>
            </form>
        </div>
    </div>
</div>

