@using Cental.EntityLayer.Entities
@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Rezervasyonlar";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<br />
<br />
<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <!-- jQuery Yükle -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <tr>
            <th>Rezervasyon ID</th>
            <th>Araba</th>
            <th>Alış Tarihi ve Saati</th>
            <th>Teslim Tarihi ve Saati</th>
            <th>Nereden Alındı</th>
            <th>Nereye Teslim Edilecek</th>
            <th>Durum</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.BookingId</td>
                <td>@booking.Car.Brand.BrandName @booking.Car.ModelName</td>
                <td>@booking.PickUpDate.ToString("dd.MM.yyyy") @booking.PickUpTime</td>
                <td>@booking.DropOffDate.ToString("dd.MM.yyyy") @booking.DropOffTime</td>
                <td>@booking.PickUpLO</td>
                <td>@booking.DropOffLO</td>
@*                 //<td id="status-@booking.BookingId">@booking.Status</td>
 *@                <td id="status-@booking.BookingId" style="font-weight: bold;">@booking.Status</td>

                <td>
                    <div class="btn-group" role="group" aria-label="Rezervasyon Durumu">
                        <!-- Onay Bekliyor Butonu -->
                        <button type="button" class="btn btn-warning status-button "style="margin-right:20px;"
                                data-status="Onay Bekliyor"
                                data-booking-id="@booking.BookingId"
                        @(booking.Status == "Onay Bekliyor" ? "disabled" : "")>
                            Onay Bekliyor

                        </button> 
                     <br />
                        <!-- Onaylandı Butonu -->
                        <button type="button" class="btn btn-success status-button" style="margin-right:20px;"
                                data-status="Onaylandı"
                                data-booking-id="@booking.BookingId"
                        @(booking.Status == "Onaylandı" ? "disabled" : "")>
                            Onaylandı
                        </button>

                        <!-- İptal Edildi Butonu -->
                        <button type="button" class="btn btn-danger status-button" style="margin-right:20px;"
                                data-status="İptal Edildi"
                                data-booking-id="@booking.BookingId"
                        @(booking.Status == "İptal Edildi" ? "disabled" : "")>
                            İptal Edildi
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function updateStatus(bookingId, status) {
        $.ajax({
            url: '/Admin/AdminBooking/UpdateStatus', // UpdateStatus action'ı
            type: 'POST',
            data: {
                bookingId: bookingId,
                status: status
            },
            success: function (response) {
                // Durum başarılıysa güncellenen durumu sayfada göster
                $('#status-' + bookingId).text(status);
                alert('Durum başarıyla güncellendi!');
            },
            error: function (xhr, status, error) {
                // Hata durumunda bir mesaj göster
                alert('Bir hata oluştu: ' + error);
            }
        });
    }

    // Butonlara tıklama eventi ekleyelim
    $(".status-button").on("click", function (e) {
        e.preventDefault();
        var status = $(this).data("status");
        var bookingId = $(this).data("booking-id");
        updateStatus(bookingId, status);
    });
</script>
