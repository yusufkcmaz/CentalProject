@using Cental.DtoLayer.TestimonialDtos
@model List<ResultTestimonialDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">📋 Yorum Listesi</h4>
        </div>

        <div class="card-body">
            <table class="table table-hover table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Profil Resmi</th>
                        <th>Ad Soyad</th>
                        <th>Ünvan</th>
                        <th>Yorum</th>
                        <th>Derecelendirme</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.TestimonialId</td>
                            <td class="align-middle">

                                <img src="@item.ImageUrl" class="img-fluid rounded-circle"
                                     style="width: 50px; height: 50px;" />

                            </td>
                            <td class="align-middle">@item.Name</td>
                            <td class="align-middle">@item.Title</td>
                            <td class="align-middle">@item.Commend</td>
                            <td class="align-middle">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Review)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-star text-body"></i>
                                    }
                                }
                            </td>


                            <td class="align-middle">

                                <a asp-area="Admin" asp-controller="AdminTestimonial" asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId"
                                   class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>


                                <button onclick="DeleteTestimonial(@item.TestimonialId)" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>Sil
                                </button> 


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

         
        <div class="card-footer text-center">
            <a asp-area="Admin" asp-controller="AdminProcess" asp-action="AddProcess"
               class="btn btn-success fw-bold">
                <i class="fas fa-plus-circle"></i> Yeni Ekle
            </a>
        </div> 
    </div>
</div>


 <script>

     function DeleteTestimonial(id){


            Swal.fire({
                title: "Silmek istediğinize emin misiniz?",
                text: "Bu İşlemi geri alamazsınız!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Evet, Sil!",
                cancelButtonText:"İptal Et"
            }).then((result) => {
                if (result.isConfirmed) {
    window.location.href = "/Admin/AdminTestimonial/DeleteTestimonial/" + id;


                }
            });


        }






</script> 









