@using Cental.EntityLayer.Entities
@model List<ContactOffice>
@{
    ViewData["Title"] = "Cındex";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<a asp-action="AddOffice" class="btn btn-primary mb-3">Yeni Ekle</a>
<h3>Şubeler alanı</h3>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Adress</th>
            <th>Telefon</th>
            <th>Harita</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactOfficeId</td>
                <td>@item.Title</td>
                <td>@item.OfficeAdress</td>
                <td>@item.Mapurl</td>
                <td>@item.OfficePhoneNumber</td>

                <td>
                    <a asp-action="EditOffice" asp-route-id="@item.ContactOfficeId" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Remove" asp-route-id="@item.ContactOfficeId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğine emin misin?');">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

