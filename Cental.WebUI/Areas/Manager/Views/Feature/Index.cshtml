@using Cental.EntityLayer.Entities
@model List<Feature>
@{
    ViewData["Title"] = "Özellikler güncelleme";
    Layout = "~/Areas/Manager/Views/ManagerLayout/Index.cshtml";
}

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FeatureId</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    <a href="@Url.Action("Update", "Feature", new { id = item.FeatureId})" class="btn btn-warning">Düzenle</a>
                    <a href="@Url.Action("Delete", "Feature", new { id = item.FeatureId })" class="btn btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>



