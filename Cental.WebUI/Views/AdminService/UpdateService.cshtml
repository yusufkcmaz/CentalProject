@model Service
@{
    ViewData["Title"] = "Servis | Güncelleme";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form method="post">
    <input type="hidden" asp-for="ServiceID" />
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control accordion-item" />
    <br />

    <label>Açıklama</label>
    <input type="text" asp-for="Description" class="form-control" />
    <br />


    <label>Görsel İcon</label>
    <input type="text" asp-for="Icon" class="form-control" />
    <br />

    
    <button class="btn btn-success">Güncelle</button>


</form>


