@model List<About>
@{
    ViewData["Title"] = "Index";
}

<h3>Hakkımızda alanı </h3>
<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>vizyon</th>
        <th>misyon</th>
        <th>Sil</th>
        <th>Güncelle</th>
        
       

    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AboutId</td>
            <td>@item.Vision</td>
            <td>@item.Mission</td>
            <td><a asp-action="DeleteAbout" asp-route-id="@item.AboutId" class="btn btn-danger">siL</a> </td>
           
        </tr>
    }

</table>
<a asp-action="CreateAbout" asp-controller="AdminAbout" class="btn btn-primary">Yeni hakkımızda ekle</a>
