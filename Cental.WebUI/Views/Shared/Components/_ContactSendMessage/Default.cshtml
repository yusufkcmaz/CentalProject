@model SendMessage
@*
        _ContactSendMessage

*@
<div class="col-xl-6 wow fadeInUp" data-wow-delay="0.1s">
    <div class="bg-secondary p-5 rounded">
        <h4 class="text-primary mb-4">İletişime geçebilirsiniz</h4>
        <form asp-action="SendMessage" asp-controller="Contact" method="post">


            <div class="row g-4">

                <div class="col-lg-12 col-xl-6">

                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Name" placeholder="Ad" required>
                        <label for="Ad">Adınız</label>
                    </div>
                </div>

                    <div class="col-lg-12 col-xl-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Email" placeholder="Mail" required>
                        <label for="name">Mail</label>
                    </div>
                </div>


                        <div class="col-12">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Subject" placeholder="Konu" required>
                        <label for="name">Konu</label>
                    </div>
                </div>

                            <div class="col-12">
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea class="form-control" placeholder="Mesajınız" asp-for="Message" style="height: 160px" required></textarea>
                            <label for="message">Mesajınız</label>
                        </div>


                    </div>
                    <br />
                    <div class="col-12">
                        <button class="btn btn-light w-100 py-3" type="submit" onclick="SendMessage()">Mesajı Gönder</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>

        function SendMessage(){

            Swal.fire({
                title: "Mesajınız başarıylan gönderildi",
                text: "En kısa sürede dönüş yapılacak",
                icon: "Success",
                showCancelButton: false,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Tamam",
                cancelButtonText:"İptal Et"
            }).then((result) => {
                if (result.isConfirmed) {
    window.location.href = "/Contact/Index/";


                }
            });


        }


</script>