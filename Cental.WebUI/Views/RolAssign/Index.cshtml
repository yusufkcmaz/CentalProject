@model List<ResultUserDto>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


@{
    int count = 0;
}

<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>Ad Soyad</th>
        <th>Kullanıcı Adı</th>
        <th>Email</th>
        <th>Rol Ata</th>
        <th>Roller</th>

    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.FullName</td>
            <td>@item.UserName</td>
            <td>@item.Email</td>
            <td>
            @foreach (var role in item.Roles)
            {
                    <span class="badge badge-info">@role</span>  <br />
            }
            </td>



            <td><a asp-action="AssignRol" asp-route-id="@item.Id" class="btn btn-danger"><i class="fa fa-trash"></i>Rol Ata</a> </td>
           
        </tr>
    }

</table>


