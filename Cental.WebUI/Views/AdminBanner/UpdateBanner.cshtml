@model UpdateBannerDto
@{
    ViewData["Title"] = "Banner güncelleme";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<form asp-action="UpdateBanner" method="post">
    <input type="hidden" asp-for=BannerId />

    <label>Açıklama</label>
    <input type="text" asp-for="Title" class="form-control" />
    <br />

    <label>Açıklama</label>
    <input type="text" asp-for="Description" class="form-control" />
    <br />

  
    <label>Giriş Fotoğrafı</label>
    <input type="text" asp-for="ImageUrl" class="form-control" />
    <br />

    <button class="btn btn-success">Güncelle</button>
    </form>