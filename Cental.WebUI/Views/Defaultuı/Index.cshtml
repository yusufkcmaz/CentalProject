
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- Carousel Start -->
@await Component.InvokeAsync("_DefaultBannerComponent")
<!-- Carousel End -->
<!-- Features Start -->
@await Component.InvokeAsync("_DefaultFeatureComponent")
<!-- Features End -->
<!-- About Start -->
@await Component.InvokeAsync("_DefaultAboutComponent")

<!-- About End -->

<!-- Fact Counter -->
@await Component.InvokeAsync("_DefaultCounterComponent")

<!-- Fact Counter -->
<!-- Services Start -->
@await Component.InvokeAsync("_DefaultServiceComponent")
<!-- Services End -->
<!-- Car categories Start -->
@await Component.InvokeAsync("_DefaultCategoriesComponent")
<!-- Car categories End -->
<!-- Car Steps Start -->
@await Component.InvokeAsync("_DefaultProcessComponent")
<!-- Car Steps End -->
<!-- Banner contact okey -->
<div class="container-fluid banner pb-5 wow zoomInDown" data-wow-delay="0.1s">
    <div class="container pb-5">
        <div class="banner-item rounded">
            <img src="~/Cental-1.0.0/img/banner-1.jpg" class="img-fluid rounded w-100" alt="">
            <div class="banner-content">
                <h2 class="text-primary">Araç kiralayın</h2>
                <h1 class="text-white">Araç kiralamak'mı istiyorsunuz?</h1>
                <p class="text-white">Bizimle iletişime geçin</p>
                <div class="banner-btn">
                 
                    <a href="/Contact/Index" class="btn btn-primary rounded-pill py-3 px-4 px-md-5 ms-2">Buradan ulaşın</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Banner End -->
<!-- Team Start -->
@await Component.InvokeAsync("_DefaultManagerComponent")
<!-- Team End -->
<!-- Testimonial Start -->
@await Component.InvokeAsync("_DefaultTestimonialComponent")
<!-- Testimonial End -->
