@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@*Partial-->Component Cağırma/Bölme.. *@
@await Component.InvokeAsync("_AdminLayoutHeadComponent")

<body class="">
    <!-- [ Pre-loader ] start -->
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    <!-- [ Pre-loader ] End -->
    <!-- [ navigation menu ] start -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponent")
    <!-- [ navigation menu ] end -->
    <!-- [ Header ] start -->
    @await Component.InvokeAsync("_AdminLayoutNavbarComponent")

    <!-- [ Header ] end -->
    <!-- [ Main Content ] start -->
    <div class="pcoded-main-container">
        <div class="pcoded-content">
            <!-- [ breadcrumb ] start -->
            @await Component.InvokeAsync("_AdminLayoutBreadComponent")
            <!-- [ breadcrumb ] end -->
            <!-- [ Main Content ] start -->
            <div class="row">
                <!-- [ sample-page ] start -->
                <div class="col-sm-12">
                    <div class="card-body">
                        @RenderBody()
                    </div>
                </div>
                <!-- [ sample-page ] end -->
            </div>
            <!-- [ Main Content ] end -->
        </div>
    </div>
    <!-- [ Main Content ] end -->
    <!-- Warning Section start -->
    <!-- Older IE warning message -->
    <!--[if lt IE 11]>
